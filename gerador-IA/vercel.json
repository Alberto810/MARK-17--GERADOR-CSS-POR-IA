{
    "version": 2,
    "builds": [
        {
            "src": "api/gerar-css",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/gerar-css"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}